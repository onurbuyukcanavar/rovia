# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# OAuth ve e-posta yönlendirmeleri için site kökü
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Harita altyapısı (açık kaynak; hepsi isteğe bağlı — docs/SETUP.md §5)
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# VALHALLA_URL=https://valhalla1.openstreetmap.de
# PHOTON_URL=https://photon.komoot.io

# İsteğe bağlı: Google girişi (Google Identity Services + Android Credential Manager). Google Cloud → OAuth
# istemcisi "Web application" kimliği; Supabase Google sağlayıcısındaki Client ID ile aynı. Boşsa OAuth yönlendirmesi.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
